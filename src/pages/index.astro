---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const devlogPosts = (await getCollection('devlog')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<BaseLayout title="Crimson Lantern Studios — Indie Game Development">

  <!-- ===== Hero Section ===== -->
  <section class="hero">
    <div class="hero-pulse" aria-hidden="true"></div>

    <div class="hero-lantern fade-in" style="--delay:0s">
      <svg class="hero-lantern-svg" viewBox="0 0 40 56" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M20 2 C20 2 12 2 12 8 L12 12 L28 12 L28 8 C28 2 20 2 20 2Z" stroke="#DC143C" stroke-width="1.5" fill="none" opacity="0.6"/>
        <rect x="10" y="12" width="20" height="4" rx="1" fill="#DC143C" opacity="0.3"/>
        <ellipse cx="20" cy="32" rx="12" ry="16" stroke="#DC143C" stroke-width="1" fill="none" opacity="0.25"/>
        <ellipse cx="20" cy="32" rx="8" ry="11" fill="url(#heroLanternGlow)" opacity="0.6"/>
        <rect x="10" y="44" width="20" height="6" rx="2" fill="#DC143C" opacity="0.2"/>
        <circle cx="20" cy="31" r="4" fill="#DC143C" opacity="0.5">
          <animate attributeName="opacity" values="0.3;0.7;0.3" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="20" cy="31" r="7" fill="#DC143C" opacity="0.1">
          <animate attributeName="r" values="6;9;6" dur="3s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.1;0.05;0.1" dur="3s" repeatCount="indefinite"/>
        </circle>
        <circle cx="20" cy="31" r="14" fill="none" stroke="#663399" stroke-width="0.5" opacity="0.15">
          <animate attributeName="r" values="12;16;12" dur="4s" repeatCount="indefinite"/>
          <animate attributeName="opacity" values="0.15;0.05;0.15" dur="4s" repeatCount="indefinite"/>
        </circle>
        <defs>
          <radialGradient id="heroLanternGlow" cx="50%" cy="45%" r="50%">
            <stop offset="0%" stop-color="#DC143C" stop-opacity="0.4"/>
            <stop offset="100%" stop-color="#DC143C" stop-opacity="0"/>
          </radialGradient>
        </defs>
      </svg>
    </div>

    <h1 class="hero-title fade-in" style="--delay:0.2s">
      <span class="hero-crimson">Crimson</span> Lantern Studios
    </h1>

    <p class="hero-tagline fade-in" style="--delay:0.4s">
      Indie Game Development · Asset Creation · AI-Augmented Pipeline
    </p>

    <div class="hero-divider fade-in" style="--delay:0.6s" aria-hidden="true"></div>

    <p class="hero-description fade-in" style="--delay:0.8s">
      A solo indie studio building games, music, and assets with an ethical AI-augmented pipeline. Creativity first. Community always. No extraction, only connection.
    </p>
  </section>

  <!-- ===== Section Separator ===== -->
  <hr class="section-separator" />

  <!-- ===== Devlog + Featured Packs ===== -->
  <section class="content-grid">
    <!-- Left column: Devlog -->
    <div class="devlog-column">
      <div class="section-label">DEVELOPMENT LOG</div>
      <h2 class="section-title">Latest Updates</h2>
      <div class="section-divider"></div>

      {devlogPosts.map((post) => (
        <article class="devlog-card fade-in">
          <time class="devlog-date" datetime={post.data.date.toISOString().slice(0, 10)}>
            {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
          </time>
          <h3 class="devlog-title">{post.data.title}</h3>
          <p class="devlog-excerpt">{post.data.excerpt}</p>
          <span class="devlog-tag">{post.data.tag}</span>
        </article>
      ))}
    </div>

    <!-- Right column: Featured Packs -->
    <aside class="packs-sidebar">
      <div class="section-label">FEATURED PACKS</div>

      <div class="pack-card fade-in">
        <h4 class="pack-title">Disturbingly Beautiful</h4>
        <p class="pack-desc">Ambient synthwave. Impossible to categorize. Deeply compelling.</p>
        <ul class="pack-details">
          <li>20 original compositions in 3 formats (WAV · OGG · MP3)</li>
          <li>WAV 16-bit 44.1kHz · OGG Vorbis ~192kbps · MP3 320kbps</li>
          <li>All tracks in G# minor for seamless in-game mixing and crossfading</li>
          <li>Average track length: 5–5.5 minutes · 106 minutes total</li>
          <li>Full-length compositions — not loops. Built for cinematics, menus, exploration, and extended gameplay.</li>
          <li>40-second demo previews included.</li>
          <li>Composed using AIVA · Full copyright held by Crimson Lantern Studios</li>
        </ul>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="pack-meta">
          <span class="pack-tracks">20 Tracks</span>
          <span class="pack-price">$80</span>
        </div>
        <!-- Coming soon: swap <span> to <a href="..."> when live -->
        <p class="pack-availability">Available now on <span class="store-link">itch.io</span>. Coming soon to <span class="store-link">Unity Asset Store</span> and <span class="store-link">FAB</span>.</p>
      </div>

      <div class="pack-card fade-in">
        <h4 class="pack-title">Blood &amp; Adrenaline</h4>
        <p class="pack-desc">Combat music. Liquid DnB meets dystopian intensity.</p>
        <ul class="pack-details">
          <li>20 original compositions in 3 formats (WAV · OGG · MP3)</li>
          <li>WAV 16-bit 44.1kHz · OGG Vorbis ~192kbps · MP3 320kbps</li>
          <li>All tracks in G# minor for seamless in-game mixing and crossfading</li>
          <li>Average track length: 5–5.5 minutes · 106 minutes total</li>
          <li>Full-length compositions — not loops. Built for combat encounters, chase sequences, and high-tension gameplay.</li>
          <li>40-second demo previews included.</li>
          <li>Composed using AIVA · Full copyright held by Crimson Lantern Studios</li>
        </ul>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="pack-meta">
          <span class="pack-tracks">20 Tracks</span>
          <span class="pack-price">$80</span>
        </div>
        <!-- Coming soon: swap <span> to <a href="..."> when live -->
        <p class="pack-availability">Available now on <span class="store-link">itch.io</span>. Coming soon to <span class="store-link">Unity Asset Store</span> and <span class="store-link">FAB</span>.</p>
      </div>

      <div class="pack-card fade-in">
        <h4 class="pack-title">Rise To It</h4>
        <p class="pack-desc">Boss battle anthology. Angelic metal meets hypnotic fury.</p>
        <ul class="pack-details">
          <li>20 original compositions in 3 formats (WAV · OGG · MP3)</li>
          <li>WAV 16-bit 44.1kHz · OGG Vorbis ~192kbps · MP3 320kbps</li>
          <li>All tracks in G# minor for seamless in-game mixing and crossfading</li>
