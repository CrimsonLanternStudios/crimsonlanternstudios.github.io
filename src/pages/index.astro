</BaseLayout>

<style>
  /* ===== Hero ===== */
  .hero {
    min-height: 80vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  .hero-pulse {
    position: absolute;
    inset: 0;
    background: radial-gradient(
      ellipse at center,
      rgba(220, 20, 60, 0.06) 0%,
      rgba(102, 51, 153, 0.04) 40%,
      transparent 70%
    );
    animation: hero-breathe 6s ease-in-out infinite;
    pointer-events: none;
  }

  @keyframes hero-breathe {
    0%, 100% { opacity: 0.5; transform: scale(1); }
    50%      { opacity: 1;   transform: scale(1.08); }
  }

  .hero-lantern {
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-lantern-svg {
    width: 120px;
    height: auto;
    filter: drop-shadow(0 0 20px rgba(220, 20, 60, 0.4)) drop-shadow(0 0 40px rgba(102, 51, 153, 0.2));
  }

  .hero-title {
    font-family: 'Cinzel', serif;
    font-size: 3rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 1rem;
    position: relative;
    z-index: 1;
  }

  .hero-crimson {
    color: var(--crimson);
  }

  .hero-tagline {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.95rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-divider {
    width: 200px;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--crimson), transparent);
    margin-bottom: 1.5rem;
    position: relative;
    z-index: 1;
  }

  .hero-description {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.1rem;
    line-height: 1.7;
    color: var(--text-secondary);
    max-width: 620px;
    position: relative;
    z-index: 1;
  }

  /* Hero staggered fade-in */
  .hero .fade-in {
    opacity: 0;
    transform: translateY(20px);
    animation: hero-fade-in 0.8s ease-out forwards;
    animation-delay: var(--delay, 0s);
  }

  @keyframes hero-fade-in {
    to { opacity: 1; transform: translateY(0); }
  }

  /* ===== Content Grid (Devlog + Packs) ===== */
  .content-grid {
    display: grid;
    grid-template-columns: 1fr 360px;
    gap: 3rem;
    align-items: start;
  }

  /* ===== Devlog Cards ===== */
  .devlog-column {
    display: flex;
    flex-direction: column;
  }

  .devlog-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
    border-left: 3px solid transparent;
  }

  .devlog-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
    border-left: 3px solid var(--crimson);
    border-image: linear-gradient(to bottom, var(--crimson), var(--purple-deep)) 1;
    border-image-slice: 0 0 0 1;
  }

  .devlog-date {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    display: block;
    margin-bottom: 0.4rem;
  }

  .devlog-title {
    font-family: 'Cinzel', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.6rem;
    line-height: 1.3;
  }

  .devlog-excerpt {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.65;
    margin-bottom: 0.8rem;
  }

  .devlog-tag {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--crimson);
    background: rgba(220, 20, 60, 0.1);
    padding: 0.2rem 0.65rem;
    border-radius: 3px;
  }

  /* ===== Packs Sidebar ===== */
  .packs-sidebar {
    position: sticky;
    top: 88px;
  }

  .pack-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1.25rem;
    margin-bottom: 1rem;
    transition: transform 0.3s ease, border-color 0.3s ease, background 0.3s ease;
  }

  .pack-card:hover {
    transform: translateY(-2px);
    border-color: var(--border-glow);
    background: var(--bg-card-hover);
  }

  .pack-title {
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.35rem;
  }

  .pack-desc {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin-bottom: 0.75rem;
  }

  .pack-details {
    list-style: none;
    padding: 0;
    margin: 0 0 0.75rem 0;
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.78rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .pack-details li {
    padding-left: 0.8rem;
    position: relative;
  }

  .pack-details li::before {
    content: '·';
    position: absolute;
    left: 0;
    color: var(--crimson);
  }

  .pack-availability {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin-top: 0.6rem;
  }

  .pack-savings {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  /* Waveform bars */
  .pack-waveform {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 24px;
    margin-bottom: 0.75rem;
  }

  .pack-waveform span {
    display: block;
    width: 3px;
    background: var(--crimson);
    border-radius: 1px;
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  .pack-waveform span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .pack-waveform span:nth-child(2) { height: 70%; animation-delay: 0.1s; }
  .pack-waveform span:nth-child(3) { height: 50%; animation-delay: 0.2s; }
  .pack-waveform span:nth-child(4) { height: 90%; animation-delay: 0.3s; }
  .pack-waveform span:nth-child(5) { height: 30%; animation-delay: 0.4s; }
  .pack-waveform span:nth-child(6) { height: 80%; animation-delay: 0.5s; }
  .pack-waveform span:nth-child(7) { height: 55%; animation-delay: 0.6s; }
  .pack-waveform span:nth-child(8) { height: 65%; animation-delay: 0.7s; }

  .pack-card:hover .pack-waveform span {
    opacity: 1;
    animation: waveform-pulse 0.8s ease-in-out infinite alternate;
  }

  @keyframes waveform-pulse {
    0%   { transform: scaleY(1); }
    100% { transform: scaleY(0.5); }
  }

  /* Pack meta row */
  .pack-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .pack-tracks {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
  }

  .pack-price {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--cyan-blue);
  }

  /* Bundle card */
  .pack-bundle {
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.08), rgba(102, 51, 153, 0.08));
    border-color: var(--border-glow);
    position: relative;
  }

  .bundle-badge {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--crimson);
    padding: 0.15rem 0.6rem;
    border-radius: 3px;
    margin-bottom: 0.6rem;
  }

  /* ===== Store Links (Coming Soon placeholders) ===== */
  .store-links {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-top: 0.6rem;
  }

  .store-link {
    font-weight: 600;
    color: var(--text-secondary);
  }

  a.store-link {
    color: var(--crimson);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  a.store-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .content-grid {
      grid-template-columns: 1fr;
    }

    .packs-sidebar {
      position: static;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: 2rem;
    }

    .hero-tagline {
      font-size: 0.8rem;
    }

    .hero-description {
      font-size: 1rem;
    }
  }
</style>

<script>
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.content-grid .fade-in').forEach((el) => {
    observer.observe(el);
  });
</script>
