        </ul>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <div class="pack-meta">
          <span class="pack-tracks">20 Tracks</span>
