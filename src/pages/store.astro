        <p class="store-card-price">$80</p>
        <!-- Coming soon: swap <span> to <a href="..."> when live -->
        <p class="store-card-availability">Available now on: <span class="store-link">itch.io</span> · Coming soon to: <span class="store-link">Unity Asset Store</span> · <span class="store-link">FAB</span></p>
      </div>

      <!-- Pack 6 — Thin Air -->
      <div class="store-card fade-in">
        <h3 class="store-card-title">Thin Air — Tension &amp; Dialog Music</h3>
        <p class="store-card-desc">The sound of something about to break. Built for negotiations, confrontations, dialog scenes, and rising stakes.</p>
        <p class="store-card-meta">20 original compositions · 106 minutes · 3 formats · G# minor</p>
        <p class="store-card-format">Full-length compositions — not loops. Built for negotiations, confrontations, dialog scenes, and rising stakes.</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <AudioPreviews packSlug="thin-air" tracks={thinAirTracks} />
        <p class="store-card-price">$80</p>
        <!-- Coming soon: swap <span> to <a href="..."> when live -->
        <p class="store-card-availability">Available now on: <span class="store-link">itch.io</span> · Coming soon to: <span class="store-link">Unity Asset Store</span> · <span class="store-link">FAB</span></p>
      </div>

      <!-- Bundle — The Crimson Collection -->
      <div class="store-card store-card-bundle fade-in">
        <span class="bundle-badge">COMPLETE BUNDLE</span>
        <h3 class="store-card-title">The Crimson Collection — Complete Bundle</h3>
        <p class="store-card-desc">All six packs. 120 compositions. 630+ minutes. Six worlds of sound in one cohesive key.</p>
        <p class="store-card-meta">120 original compositions · 630+ minutes · 3 formats · G# minor</p>
        <p class="store-card-format">Full-length compositions — not loops.</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="store-card-price">$400 <span class="bundle-savings">(Save $80 vs. buying individually)</span></p>
        <!-- Coming soon: swap <span> to <a href="..."> when live -->
        <p class="store-card-availability">Available now on: <span class="store-link">itch.io</span> · Coming soon to: <span class="store-link">Unity Asset Store</span> · <span class="store-link">FAB</span></p>
      </div>

    </div>

    <!-- ===== Store Footer ===== -->
    <div class="store-footer fade-in">
      <p>All packs licensed for use in games, films, apps, and interactive media. See individual marketplace licenses for full terms.</p>
      <p>Questions? Contact <a href="mailto:crimsonlanternstudios@gmail.com">crimsonlanternstudios@gmail.com</a></p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== Store Section ===== */
  .store-section {
    text-align: center;
  }

  .store-section .section-divider {
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== Store Intro ===== */
  .store-intro {
    max-width: 800px;
    margin: 1.5rem auto 2rem;
    text-align: left;
  }

  .store-intro p {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* ===== Card Grid ===== */
  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: left;
    margin-top: 1rem;
  }

  /* ===== Store Card ===== */
  .store-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1.5rem;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .store-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-glow);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    background: var(--bg-card-hover);
  }

  /* ===== Bundle Card ===== */
  .store-card-bundle {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.06), rgba(102, 51, 153, 0.06));
    border-color: var(--border-glow);
  }

  .bundle-badge {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--crimson);
    padding: 0.12rem 0.5rem;
    border-radius: 3px;
    margin-bottom: 0.6rem;
  }

  .bundle-savings {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* ===== Card Title ===== */
  .store-card-title {
    font-family: 'Cinzel', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  /* ===== Card Description ===== */
  .store-card-desc {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  /* ===== Card Meta ===== */
  .store-card-meta {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  /* ===== Card Format ===== */
  .store-card-format {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin-bottom: 0.6rem;
  }

  /* ===== Store Links (Coming Soon placeholders) ===== */
  .store-link {
    font-weight: 600;
    color: var(--text-secondary);
  }

  a.store-link {
    color: var(--crimson);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  a.store-link:hover {
    color: var(--text-primary);
    text-decoration: underline;
  }

  /* ===== Card Price ===== */
  .store-card-price {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--crimson);
    margin-bottom: 0.4rem;
  }

  /* ===== Card Availability ===== */
  .store-card-availability {
