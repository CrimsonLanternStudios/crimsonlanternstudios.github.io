---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Store — Crimson Lantern Studios">

  <!-- ===== Section Header ===== -->
  <section class="store-section">
    <div class="section-label">STORE</div>
    <h2 class="section-title">Music Asset Packs</h2>
    <div class="section-divider"></div>

    <!-- ===== Intro ===== -->
    <div class="store-intro fade-in">
      <p>All music packs are original compositions created using AIVA, with full copyright ownership held by Crimson Lantern Studios. Each pack includes WAV (16-bit, 44.1kHz), OGG Vorbis (~192kbps), and MP3 (320kbps) formats. All tracks are composed in G# minor for seamless in-game mixing and crossfading.</p>
      <p>These are full-length compositions (5–5.5 minutes each), not loops. Built for cinematics, menus, exploration, combat, boss encounters, and extended gameplay sessions. 30-second demo previews are included in every pack.</p>
    </div>

    <!-- ===== Pack Cards ===== -->
    <div class="store-grid">

      <!-- Pack 1 — Disturbingly Beautiful -->
      <div class="store-card fade-in">
        <h3 class="store-card-title">Disturbingly Beautiful — Ambient Synthwave</h3>
        <p class="store-card-desc">Impossible to categorize. Deeply compelling. Atmosphere that pulls you in and doesn't let go.</p>
        <p class="store-card-meta">20 tracks · 100+ minutes · 3 formats · G# minor</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="store-card-price">$80</p>
        <p class="store-card-availability">Coming soon on: itch.io · Unity Asset Store · FAB</p>
      </div>

      <!-- Pack 2 — Blood & Adrenaline -->
      <div class="store-card fade-in">
        <h3 class="store-card-title">Blood &amp; Adrenaline — Combat Music</h3>
        <p class="store-card-desc">Liquid DnB meets dystopian intensity. Built for combat encounters, chase sequences, and high-tension gameplay.</p>
        <p class="store-card-meta">20 tracks · 100+ minutes · 3 formats · G# minor</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="store-card-price">$80</p>
        <p class="store-card-availability">Coming soon on: itch.io · Unity Asset Store · FAB</p>
      </div>

      <!-- Pack 3 — Rise To It -->
      <div class="store-card fade-in">
        <h3 class="store-card-title">Rise To It — Boss Battle Anthology</h3>
        <p class="store-card-desc">Angelic metal meets hypnotic fury. Built for boss encounters, climactic moments, and final confrontations.</p>
        <p class="store-card-meta">20 tracks · 100+ minutes · 3 formats · G# minor</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="store-card-price">$80</p>
        <p class="store-card-availability">Coming soon on: itch.io · Unity Asset Store · FAB</p>
      </div>

      <!-- Bundle — The Crimson Collection -->
      <div class="store-card store-card-bundle fade-in">
        <span class="bundle-badge">COMPLETE BUNDLE</span>
        <h3 class="store-card-title">The Crimson Collection — Complete Bundle</h3>
        <p class="store-card-desc">All three packs. 60 tracks. 300+ minutes. Three worlds of sound in one cohesive key.</p>
        <p class="store-card-meta">60 tracks · 300+ minutes · 3 formats · G# minor</p>
        <div class="pack-waveform" aria-hidden="true">
          <span></span><span></span><span></span><span></span>
          <span></span><span></span><span></span><span></span>
        </div>
        <p class="store-card-price">$200 <span class="bundle-savings">(Save $40 vs. buying individually)</span></p>
        <p class="store-card-availability">Coming soon on: itch.io · Unity Asset Store · FAB</p>
      </div>

    </div>

    <!-- ===== Store Footer ===== -->
    <div class="store-footer fade-in">
      <p>All packs licensed for use in games, films, apps, and interactive media. See individual marketplace licenses for full terms.</p>
      <p>Questions? Contact <a href="mailto:crimsonlanternstudios@gmail.com">crimsonlanternstudios@gmail.com</a></p>
    </div>
  </section>

</BaseLayout>

<style>
  /* ===== Store Section ===== */
  .store-section {
    text-align: center;
  }

  .store-section .section-divider {
    margin-left: auto;
    margin-right: auto;
  }

  /* ===== Store Intro ===== */
  .store-intro {
    max-width: 800px;
    margin: 1.5rem auto 2rem;
    text-align: left;
  }

  .store-intro p {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.95rem;
    color: var(--text-secondary);
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* ===== Card Grid ===== */
  .store-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem;
    text-align: left;
    margin-top: 1rem;
  }

  /* ===== Store Card ===== */
  .store-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 6px;
    padding: 1.5rem;
    position: relative;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .store-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-glow);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
    background: var(--bg-card-hover);
  }

  /* ===== Bundle Card ===== */
  .store-card-bundle {
    grid-column: 1 / -1;
    background: linear-gradient(135deg, rgba(220, 20, 60, 0.06), rgba(102, 51, 153, 0.06));
    border-color: var(--border-glow);
  }

  .bundle-badge {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: #fff;
    background: var(--crimson);
    padding: 0.12rem 0.5rem;
    border-radius: 3px;
    margin-bottom: 0.6rem;
  }

  .bundle-savings {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text-secondary);
  }

  /* ===== Card Title ===== */
  .store-card-title {
    font-family: 'Cinzel', serif;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  /* ===== Card Description ===== */
  .store-card-desc {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.9rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }

  /* ===== Card Meta ===== */
  .store-card-meta {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
  }

  /* ===== Card Price ===== */
  .store-card-price {
    font-family: 'Rajdhani', sans-serif;
    font-size: 1.3rem;
    font-weight: 700;
    color: var(--crimson);
    margin-bottom: 0.4rem;
  }

  /* ===== Card Availability ===== */
  .store-card-availability {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--text-muted);
    letter-spacing: 0.03em;
  }

  /* ===== Waveform Bars ===== */
  .pack-waveform {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 20px;
    margin-bottom: 0.6rem;
  }

  .pack-waveform span {
    display: block;
    width: 3px;
    background: var(--crimson);
    border-radius: 1px;
    opacity: 0.35;
    transition: opacity 0.3s ease;
  }

  .pack-waveform span:nth-child(1) { height: 40%; animation-delay: 0s; }
  .pack-waveform span:nth-child(2) { height: 70%; animation-delay: 0.1s; }
  .pack-waveform span:nth-child(3) { height: 50%; animation-delay: 0.2s; }
  .pack-waveform span:nth-child(4) { height: 90%; animation-delay: 0.3s; }
  .pack-waveform span:nth-child(5) { height: 30%; animation-delay: 0.4s; }
  .pack-waveform span:nth-child(6) { height: 80%; animation-delay: 0.5s; }
  .pack-waveform span:nth-child(7) { height: 55%; animation-delay: 0.6s; }
  .pack-waveform span:nth-child(8) { height: 65%; animation-delay: 0.7s; }

  .store-card:hover .pack-waveform span {
    opacity: 1;
    animation: waveform-pulse 0.8s ease-in-out infinite alternate;
  }

  @keyframes waveform-pulse {
    0%   { transform: scaleY(1); }
    100% { transform: scaleY(0.5); }
  }

  /* ===== Store Footer ===== */
  .store-footer {
    max-width: 800px;
    margin: 2.5rem auto 0;
    text-align: center;
  }

  .store-footer p {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 0.85rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 0.5rem;
  }

  .store-footer a {
    color: var(--crimson);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .store-footer a:hover {
    color: var(--text-primary);
  }

  /* ===== Responsive ===== */
  @media (max-width: 900px) {
    .store-grid {
      grid-template-columns: 1fr;
    }

    .store-card-bundle {
      grid-column: 1;
    }
  }
</style>

<script>
  // Scroll fade-in observer
  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.1 }
  );

  document.querySelectorAll('.store-section .fade-in').forEach((el) => {
    observer.observe(el);
  });
</script>
