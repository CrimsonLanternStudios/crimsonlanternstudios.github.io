---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('devlog');
  return posts.map((post) => ({
    params: { slug: post.id.replace(/\.md$/, '') },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout title={`${post.data.title} — Crimson Lantern Studios`}>
  <article class="devlog-post">
    <a href="/devlog/" class="back-link">&larr; All Updates</a>

    <div class="post-meta">
      <time class="devlog-date" datetime={post.data.date.toISOString().slice(0, 10)}>
        {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric', timeZone: 'UTC' })}
      </time>
      <span class="devlog-tag">{post.data.tag}</span>
    </div>

    <h1 class="post-title">{post.data.title}</h1>

    <div class="post-body">
      <Content />
    </div>
  </article>
</BaseLayout>

<style>
  .devlog-post {
    max-width: 760px;
  }

  .back-link {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    margin-bottom: 2rem;
    transition: color 0.3s ease;
  }

  .back-link:hover {
    color: var(--crimson);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .devlog-date {
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--crimson);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .devlog-tag {
    display: inline-block;
    font-family: 'Rajdhani', sans-serif;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--crimson);
    background: rgba(220, 20, 60, 0.1);
    padding: 0.2rem 0.65rem;
    border-radius: 3px;
  }

  .post-title {
    font-family: 'Cinzel', serif;
    font-size: 2rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 2rem;
    line-height: 1.3;
  }

  .post-body {
    font-family: 'Source Sans 3', sans-serif;
    font-size: 1.05rem;
    color: var(--text-secondary);
    line-height: 1.8;
  }

  .post-body :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-body :global(strong) {
    color: var(--text-primary);
  }

  @media (max-width: 768px) {
    .post-title {
      font-size: 1.5rem;
    }
  }
</style>
